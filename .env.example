# API (optional for local demo)
API_BASE_URL=
API_KEY=

# Local Postgres (pipeline warehouse/demo target)
PGHOST=localhost
PGPORT=5432
PGDATABASE=fare_db
PGUSER=fare_user
PGPASSWORD=CHANGE_ME

# Airflow metadata database (airflow/docker-compose.airflow.yml)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_PASSWORD=CHANGE_ME

# Airflow webserver/session secret
AIRFLOW_WEBSERVER_SECRET_KEY=CHANGE_ME_LONG_RANDOM_VALUE

# Airflow Admin bootstrap user (airflow-init)
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME
AIRFLOW_ADMIN_FIRSTNAME=Airflow
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# AWS (optional)
AWS_REGION=us-east-1
S3_BUCKET=
S3_PREFIX_BRONZE=bronze
