# API (optional for local demo)
API_BASE_URL=
API_KEY=

# Local Postgres (pipeline warehouse/demo target)
PGHOST=localhost
PGPORT=5432
PGDATABASE=fare_db
PGUSER=fare_user
PGPASSWORD=CHANGE_ME

# Airflow metadata database (airflow/docker-compose.airflow.yml)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_PASSWORD=CHANGE_ME

# Airflow webserver/session secret
AIRFLOW_WEBSERVER_SECRET_KEY=CHANGE_ME_LONG_RANDOM_VALUE

# Airflow Admin bootstrap user (airflow-init)
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME
AIRFLOW_ADMIN_FIRSTNAME=Airflow
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# AWS S3 Bronze ingestion (Week 7 proof path)
# Do not commit real AWS keys. Prefer `aws configure sso`, `aws configure`,
# or temporary shell environment variables outside this file.
AWS_REGION=us-east-1
# AWS_PROFILE=your-profile-name
S3_BUCKET=
S3_PREFIX_BRONZE=bronze
BRONZE_RERUN_BEHAVIOR=overwrite

# AWS Redshift Serverless warehouse proof (Week 8)
# Keep real values in your shell or private .env only; never commit credentials.
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DBNAME=dev
REDSHIFT_USER=
REDSHIFT_PASSWORD=CHANGE_ME
REDSHIFT_SCHEMA_RAW=raw

# Redshift COPY role and S3 source.
# S3_COPY_URI overrides S3_BUCKET/S3_PREFIX when set.
IAM_ROLE_ARN=arn:aws:iam::<account-id>:role/<redshift-s3-copy-role>
S3_PREFIX=bronze/dt=
S3_COPY_URI=
