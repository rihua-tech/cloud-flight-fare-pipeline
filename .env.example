# API (optional for local demo)
API_BASE_URL=
API_KEY=

# Local Postgres (pipeline warehouse/demo target)
PGHOST=localhost
PGPORT=5432
PGDATABASE=fare_db
PGUSER=fare_user
PGPASSWORD=CHANGE_ME

# Airflow metadata database (airflow/docker-compose.airflow.yml)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_PASSWORD=CHANGE_ME

# Airflow webserver/session secret
AIRFLOW_WEBSERVER_SECRET_KEY=CHANGE_ME_LONG_RANDOM_VALUE

# Airflow Admin bootstrap user (airflow-init)
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME
AIRFLOW_ADMIN_FIRSTNAME=Airflow
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# AWS S3 Bronze ingestion (Week 7 proof path)
# Do not commit real AWS keys. Prefer `aws configure sso`, `aws configure`,
# or temporary shell environment variables outside this file.
AWS_REGION=us-east-1
# AWS_PROFILE=your-profile-name
S3_BUCKET=
S3_PREFIX_BRONZE=bronze
BRONZE_RERUN_BEHAVIOR=overwrite

# AWS Redshift Serverless warehouse proof (Week 8)
# Keep real values in your shell or private .env only; never commit credentials.
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DBNAME=dev
REDSHIFT_USER=
REDSHIFT_PASSWORD=CHANGE_ME
REDSHIFT_SCHEMA_RAW=raw

# Redshift COPY role and S3 source.
# S3_COPY_URI overrides S3_BUCKET/S3_PREFIX when set.
IAM_ROLE_ARN=arn:aws:iam::<account-id>:role/<redshift-s3-copy-role>
S3_PREFIX=bronze/dt=
S3_COPY_URI=

# AWS ECS/Fargate scheduled batch proof (Week 9)
# These values are placeholders for docs/templates. Keep real ARNs, subnet IDs,
# secret ARNs, and account-specific values in your shell, AWS Console, or private .env.
ECR_REPOSITORY=cloud-flight-fare-pipeline-batch
ECS_CLUSTER_NAME=cloud-flight-fare-pipeline-week9
ECS_TASK_FAMILY=cloud-flight-fare-pipeline-batch
ECS_CONTAINER_NAME=flight-fare-batch
ECS_LOG_GROUP=/ecs/cloud-flight-fare-pipeline/week9
ECS_TASK_EXECUTION_ROLE_ARN=arn:aws:iam::<account-id>:role/<ecs-task-execution-role>
ECS_TASK_ROLE_ARN=arn:aws:iam::<account-id>:role/<ecs-task-role>
EVENTBRIDGE_SCHEDULER_ROLE_ARN=arn:aws:iam::<account-id>:role/<eventbridge-scheduler-ecs-role>
ECS_SUBNET_IDS=subnet-<id-1>,subnet-<id-2>
ECS_SECURITY_GROUP_IDS=sg-<id>
REDSHIFT_PASSWORD_SECRET_ARN=arn:aws:secretsmanager:<region>:<account-id>:secret:<redshift-password-secret>

# Batch runner configuration used by Dockerfile.batch / ECS task definition.
BATCH_PIPELINE_STEPS=s3_ingest,redshift_load,dbt_build,redshift_verify
BATCH_DBT_TARGET=redshift
BATCH_DBT_DEPS=true
PIPELINE_RUN_DATE=
PIPELINE_START_DATE=
PIPELINE_DAYS=1
